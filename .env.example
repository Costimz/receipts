# Vultr Serverless Inference key. Lives only in the app process, never in a sandbox.
INFERENCE_API_KEY=
INFERENCE_BASE_URL=https://api.vultrinference.com/v1
# Pick from https://api.vultrinference.com/v1/models
MODEL_CODE=glm-5.3
MODEL_FAST=glm-5.3-flash
REASONING_EFFORT=low
# 'runsc' (gVisor) on the VM. setup.sh installs it. Leave empty for plain runc.
SANDBOX_RUNTIME=runsc
PUBLIC_RATE_PER_HOUR=8
